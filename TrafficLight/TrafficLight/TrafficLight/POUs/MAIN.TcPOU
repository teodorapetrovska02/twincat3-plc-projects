//			   dwYellowTimeOn := dwYellowTimeOn,
//			   dwYellowBlinkingTimeOn := dwYellowBlinkingTimeOn, dwYellowBlinkingTimeOff := dwYellowBlinkingTimeOff,);			  ]]></ST>
    </Implementation>
